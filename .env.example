# DeepSeek API key for Vietnamese narrative generation.
# Do NOT commit `.env` (it's gitignored).
DEEPSEEK_API_KEY=put_your_key_here

# Nightly VN100 EOD accumulation scanner. Never commit real values.
SCAN_API_SOURCES=VCI,KBS
# VIETFIN is accepted as an alias for DNSE, but does not add quota. The free
# vnstock package currently exposes DNSE for brokerage, not equity OHLCV;
# leave DNSE out until an OHLCV adapter is explicitly available.
SCAN_SOURCE_REQUESTS_PER_MINUTE=20
SCAN_SOURCE_LIMITS=VCI=20,KBS=20,DNSE=15
SCAN_SOURCE_USAGE_RATIO=0.78
SCAN_REQUEST_JITTER_MIN_SEC=1.25
SCAN_REQUEST_JITTER_MAX_SEC=3.75
SCAN_SOURCE_ERROR_COOLDOWN_MIN_SEC=30
SCAN_SOURCE_ERROR_COOLDOWN_MAX_SEC=120
SCAN_SOURCE_RECOVER_AFTER_SEC=300
SCAN_RETRY_AFTER_MAX_SEC=300
SCAN_MAX_WORKERS=2
SCAN_REQUEST_ATTEMPTS=3
SCAN_TIMEZONE=Asia/Ho_Chi_Minh
SCAN_BOOTSTRAP_CALENDAR_DAYS=900
SCAN_OVERLAP_CALENDAR_DAYS=7
SCAN_MIN_BARS=120
SCAN_MIN_AVERAGE_VALUE_VND=5000000000
SCAN_MAX_DISTANCE_TO_BREAKOUT_PCT=6
SCAN_MAX_RESULTS=20
SCAN_DATABASE_PATH=data/vn100_ohlcv.sqlite
SCAN_OUTPUT_DIR=artifacts/live_scan/latest

# Rotate leaked values before setting these in a local .env or GitHub Secrets.
VNSTOCK_API_KEY=replace_after_rotation
TELEGRAM_BOT_TOKEN=replace_after_rotation
TELEGRAM_CHAT_ID=replace_with_your_chat_id
GEMINI_API_KEY=replace_after_rotation
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_ENABLED=1

# Cross-repo deterministic risk gate. When it is unavailable or stale, the
# production alert publishes no candidates rather than bypassing the gate.
THIUCUBU_ENABLED=1
THIUCUBU_REPORT_URL=https://raw.githubusercontent.com/maikhanhthieu-droid/THIUCUBU/main/data/filter_feed_latest.json
THIUCUBU_MAX_AGE_DAYS=3
THIUCUBU_ENFORCE=0

# Optional independent pattern-review providers. They cannot alter scanner or
# THIUCUBU eligibility; their output is written only to ai_pattern_review.json.
OPENAI_API_KEY=replace_after_rotation
OPENAI_MODEL=gpt-4.1-mini
ZAI_API_KEY=replace_after_rotation
ZAI_MODEL=glm-4.5-air
AI_REVIEW_ENABLED=0

# Optional overrides:
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-v4-flash
SCAN_STARTUP_JITTER_MAX_SEC=180
