{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chartpatternscan.local/schemas/scanner_v2/eod_candidate.schema.json",
  "title": "VN100 live-safe EOD accumulation candidate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "symbol",
    "pattern_id",
    "pattern_name_vi",
    "status",
    "as_of_date",
    "formation_start",
    "formation_end",
    "base_days",
    "close",
    "support",
    "resistance",
    "distance_to_breakout_pct",
    "range_pct",
    "volume_ratio_5_20",
    "average_value_20_vnd",
    "setup_score",
    "source",
    "detector_version",
    "known_data_only",
    "reasons",
    "risk_note"
  ],
  "properties": {
    "symbol": {
      "type": "string",
      "pattern": "^[A-Z0-9]{2,12}$"
    },
    "pattern_id": {
      "enum": [
        "flat_base",
        "ascending_triangle",
        "symmetrical_triangle",
        "bull_flag",
        "volatility_contraction"
      ]
    },
    "pattern_name_vi": {
      "type": "string",
      "minLength": 3
    },
    "status": {
      "enum": [
        "forming",
        "near_breakout",
        "breakout_today"
      ]
    },
    "as_of_date": {
      "type": "string",
      "format": "date"
    },
    "formation_start": {
      "type": "string",
      "format": "date"
    },
    "formation_end": {
      "type": "string",
      "format": "date"
    },
    "base_days": {
      "type": "integer",
      "minimum": 5
    },
    "close": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "support": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "resistance": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "distance_to_breakout_pct": {
      "type": "number",
      "minimum": -2,
      "maximum": 20
    },
    "range_pct": {
      "type": "number",
      "minimum": 0
    },
    "volume_ratio_5_20": {
      "type": "number",
      "minimum": 0
    },
    "average_value_20_vnd": {
      "type": "number",
      "minimum": 0
    },
    "setup_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "source": {
      "type": "string",
      "minLength": 2
    },
    "detector_version": {
      "const": "vn100_accumulation_eod_v1"
    },
    "known_data_only": {
      "const": true
    },
    "reasons": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "risk_note": {
      "type": "string",
      "minLength": 10
    }
  }
}
