{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "taxonomy_lineage.schema.json",
  "title": "Scanner V2 Taxonomy Lineage",
  "type": "object",
  "required": ["version", "lineage_policy", "lineage"],
  "properties": {
    "version": {
      "type": "string"
    },
    "lineage_policy": {
      "type": "object"
    },
    "lineage": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "bulkowski_chapters",
          "source_patterns",
          "normalized_rule_spec",
          "scanner_pattern_key",
          "result_payload_contract",
          "book_v2_chapters",
          "status"
        ],
        "properties": {
          "bulkowski_chapters": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "integer",
              "minimum": 1
            }
          },
          "source_patterns": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "normalized_rule_spec": {
            "type": "string",
            "minLength": 1
          },
          "scanner_pattern_key": {
            "type": "string",
            "minLength": 1
          },
          "result_payload_contract": {
            "type": "string",
            "minLength": 1
          },
          "book_v2_chapters": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "status": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
