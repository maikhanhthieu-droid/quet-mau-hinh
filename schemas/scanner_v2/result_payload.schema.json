{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "result_payload.schema.json",
  "title": "Scanner V2 Result Payload",
  "type": "object",
  "required": [
    "scanner_version",
    "pattern_key",
    "scanner_pattern_key",
    "spec_hash",
    "source_chapters",
    "coverage",
    "official_ready"
  ],
  "properties": {
    "scanner_version": {
      "const": "v2_contract_first"
    },
    "pattern_key": {
      "type": "string"
    },
    "scanner_pattern_key": {
      "type": "string"
    },
    "spec_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source_chapters": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 1
      }
    },
    "coverage": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["rule_id", "rule_type", "module", "status", "reason"],
        "properties": {
          "rule_id": {
            "type": "string"
          },
          "rule_type": {
            "type": "string"
          },
          "module": {
            "type": ["string", "null"]
          },
          "status": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        }
      }
    },
    "official_ready": {
      "type": "boolean"
    }
  },
  "additionalProperties": true
}
